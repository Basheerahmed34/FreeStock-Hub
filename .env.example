# ==========================================
# FreeStock Hub Environment Configuration
# ==========================================

# Port (default: 3000)
PORT=3000

# Base URL
APP_URL="https://freestockhub.org"

# ==========================================
# Optional Provider API Keys
# Openverse, Wikimedia Commons, and Iconify do NOT require any API keys.
# Set any of the following to activate extra providers:
# ==========================================

# Pexels (Photos & 4K Videos)
# Get your free key at: https://www.pexels.com/api/
PEXELS_API_KEY=""

# Pixabay (Photos, Videos, Illustrations & Vectors)
# Get your free key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=""

# Unsplash (High-Resolution Creative Photography)
# Get your free Access Key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# GIPHY (Animated GIFs & Stickers)
# Get your free key at: https://developers.giphy.com/
GIPHY_API_KEY=""

# Freesound (Sound Effects, Field Audio & Foley Samples)
# Get your free token at: https://freesound.org/help/developers/
FREESOUND_API_KEY=""
